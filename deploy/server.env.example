# Install the completed file at /etc/wam/server.env with mode 600.
# Copy the three email settings from the private credentials/email-auth.env.
WAM_ENV=production
WAM_BIND=127.0.0.1:3000
WAM_PUBLIC_ORIGIN=https://webagenticmemory.com
WAM_MCP_PUBLIC_URL=https://webagenticmemory.com/mcp
WAM_MCP_ALLOWED_ORIGINS=https://webagenticmemory.com
WAM_DATA_DIR=/var/lib/wam
WAM_EXAMPLES=off
# Dedicated database and shared Redis. Use verified TLS for remote services.
WAM_DATABASE_URL=
WAM_RATE_LIMIT_REDIS_URL=
WAM_RATE_LIMIT_KEY_SECRET=
# Caddy on the same host forwards only its trusted client chain.
WAM_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
RESEND_API_KEY=
WAM_EMAIL_FROM="Web Agentic Memory <noreply@webagenticmemory.com>"
WAM_EMAIL_IDENTITY_SECRET=
# Example only: set the real recipient in private runtime env. Digests reuse the Resend key/sender.
WAM_DIAGNOSTICS_EMAIL_TO=alerts@example.test
