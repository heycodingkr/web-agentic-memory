[Unit]
Description=Web Agentic Memory API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wam
Group=wam
WorkingDirectory=/opt/web-agentic-memory
EnvironmentFile=/etc/wam/server.env
ExecStart=/opt/web-agentic-memory/target/release/wam-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
StateDirectory=wam
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wam

[Install]
WantedBy=multi-user.target
