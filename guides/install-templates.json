{
  "version": 1,
  "verified_at": "2026-10-27",
  "name": "web-memory",
  "hosts": {
    "codex": {
      "program": "codex",
      "remote": [
        "mcp",
        "add",
        "web-memory",
        "--url",
        "{mcp_endpoint}"
      ],
      "local": [
        "mcp",
        "add",
        "web-memory",
        "--env",
        "WAM_ENDPOINT={endpoint}",
        "--env",
        "WAM_CONFIG_DIR={config_dir}",
        "--",
        "{mcp_binary}"
      ],
      "get": [
        "mcp",
        "get",
        "web-memory",
        "--json"
      ],
      "remove": [
        "mcp",
        "remove",
        "web-memory"
      ]
    },
    "claude-code": {
      "program": "claude",
      "remote": [
        "mcp",
        "add",
        "--transport",
        "http",
        "--scope",
        "{scope}",
        "web-memory",
        "{mcp_endpoint}"
      ],
      "local": [
        "mcp",
        "add",
        "--scope",
        "{scope}",
        "web-memory",
        "--env",
        "WAM_ENDPOINT={endpoint}",
        "--env",
        "WAM_CONFIG_DIR={config_dir}",
        "--",
        "{mcp_binary}"
      ],
      "get": [
        "mcp",
        "get",
        "web-memory"
      ],
      "remove": [
        "mcp",
        "remove",
        "--scope",
        "{scope}",
        "web-memory"
      ]
    }
  }
}
