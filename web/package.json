{
	"name": "web-agentic-memory",
	"private": true,
	"version": "0.0.1",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test tests/*.test.mjs",
		"test:smoke": "playwright test",
		"test:oauth": "playwright test --config playwright.oauth.config.ts",
		"test:guide": "playwright test --config playwright.guide.config.ts",
		"test:ui": "playwright test --config playwright.ui.config.ts",
		"test:discovery": "playwright test --config playwright.discovery.config.ts",
		"test:security": "playwright test --config playwright.security.config.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
