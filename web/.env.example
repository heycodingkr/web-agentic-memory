# Optional public MCP endpoint shown by the setup guide at build time.
# The public website defaults to this canonical URL; override for self-hosted services.
# Local development and other deployments use their configured API or same-origin /mcp.
VITE_WAM_MCP_ENDPOINT=https://api.webagenticmemory.com/mcp

# Public origin of the site, used for the absolute og:image URL in link previews. Optional.
VITE_SITE_URL=https://webagenticmemory.com

# Optional source repository override. The public GitHub repository is linked by default.
VITE_WAM_SOURCE_URL=https://github.com/heycodingkr/web-agentic-memory
