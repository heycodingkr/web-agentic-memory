# Optional public MCP endpoint shown by the setup guide at build time.
# If omitted, the guide uses the current site's /mcp endpoint (or localhost:3000 in dev).
VITE_WAM_MCP_ENDPOINT=https://wam.example.com/mcp

# Public origin of the site, used for the absolute og:image URL in link previews. Optional.
VITE_SITE_URL=https://wam.example.com
